# Java 백엔드 URL (로컬: http://localhost:8080, 배포: https://your-ngrok-url.ngrok-free.dev)
JAVA_BACKEND_URL=http://localhost:8080

# AI 서버 접근을 허용할 오리진 목록 (쉼표 구분)
# 로컬 개발: http://localhost:8080,http://localhost:3000
# 배포 포함: http://localhost:8080,https://your-java-deployed-url.com
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000


# ── 라즈베리파이 모듈(ocr/, rpi/) 전용 — pi_backend.py가 읽는다 ───────────────
# 측정 결과를 올릴 Java 백엔드 주소. 위 JAVA_BACKEND_URL과 보통 같다.
BACKEND_URL=http://localhost:8080

# 인증: 아래 둘 중 하나만 채우면 된다.
#   (a) 발급받은 JWT를 직접 지정
BACKEND_TOKEN=
#   (b) 계정을 주면 /api/auth/login으로 토큰을 받아 쓴다
BACKEND_USERNAME=
BACKEND_PASSWORD=

# 업로드 대상 학생 ID (--student-id 인자로 덮어쓸 수 있음)
STUDENT_ID=
